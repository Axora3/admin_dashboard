# ---------------------------------------------------------------------------
# AXORA Admin — environment
# Copy to .env.local and fill in. Never commit real secrets.
# ---------------------------------------------------------------------------

# Supabase project (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used for host -> store resolution and privileged server tasks.
# NEVER expose this to the browser (do not prefix with NEXT_PUBLIC_).
SUPABASE_SERVICE_ROLE_KEY=
AXORA_AUTH_MODE=auto
# Canonical HTTPS origin for password recovery emails; no trailing slash.
AXORA_APP_URL=https://admin.axora.mn
# Platform management metadata (Supabase in production, local for isolated development only)
AXORA_PLATFORM_STORAGE=supabase
# Random server-only scheduler secret (at least 32 characters)
AXORA_JOB_SECRET=
# Optional dedicated URL for the scheduler; defaults to AXORA_APP_URL
AXORA_JOB_ENDPOINT=

# Canonical admin hostname. Requests to this host are treated as the admin app.
ADMIN_HOST=admin.axora.mn
# Base domain used for generated storefront hostnames (slug.axora.mn).
PLATFORM_BASE_DOMAIN=axora.mn

# Secret used to sign the local demo session cookie (min 32 chars).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# First super admin (used by `npm run setup:admin` / seed script).
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# DEMO MODE
# When Supabase env vars are absent the app runs in clearly-labelled demo
# mode against an in-memory dataset. Force it on/off with this flag.
# ---------------------------------------------------------------------------
AXORA_DEMO_MODE=auto
# Demo credentials (only used in demo mode)
DEMO_ADMIN_EMAIL=admin@axora.mn
DEMO_ADMIN_PASSWORD=AxoraDemo!2026
